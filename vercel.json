{
  "rewrites": [
    {
      "source": "/b/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|Googlebot|bingbot|TelegramBot|Pinterestbot|Applebot).*"
        }
      ],
      "destination": "https://probable-fun.onrender.com/b/:path*"
    },
    {
      "source": "/bracket",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|Googlebot|bingbot|TelegramBot|Pinterestbot|Applebot).*"
        }
      ],
      "destination": "https://probable-fun.onrender.com/bracket"
    },
    {
      "source": "/market/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|Googlebot|bingbot|TelegramBot|Pinterestbot|Applebot).*"
        }
      ],
      "destination": "https://probable-fun.onrender.com/market/:path*"
    },
    {
      "source": "/p/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|Googlebot|bingbot|TelegramBot|Pinterestbot|Applebot).*"
        }
      ],
      "destination": "https://probable-fun.onrender.com/p/:path*"
    },
    {
      "source": "/predictor/:path*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(facebookexternalhit|Facebot|Twitterbot|LinkedInBot|Slackbot|Discordbot|Googlebot|bingbot|TelegramBot|Pinterestbot|Applebot).*"
        }
      ],
      "destination": "https://probable-fun.onrender.com/predictor/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://probable-fun.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
